<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Softplan.Soft.Suite.Dje.Sdk</AssemblyName>
    <RootNamespace>Softplan.Soft.Suite.Dje.Sdk</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="NuGet">
    <PackageId>Dje.Cnj</PackageId>
    <Title>DJE CNJ .NET SDK</Title>
    <Description>Strongly typed .NET SDK for the CNJ Domicílio Judicial Eletrônico (DJE) API, generated from its OpenAPI specification with AutoSDK. Community SDK, not an official CNJ package.</Description>
    <PackageTags>dje;cnj;domicilio-judicial-eletronico;pdpj;comunicacoes;judiciario;api;client;sdk;dotnet;openapi;autosdk</PackageTags>
    <PackageProjectUrl>https://github.com/softplan/softplan-soft-suite-dje-sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/softplan/softplan-soft-suite-dje-sdk-dotnet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
